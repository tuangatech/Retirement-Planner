    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@types/react-router-dom": "^5.3.3",
        "@types/recharts": "^1.8.29",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
