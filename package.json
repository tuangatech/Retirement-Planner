        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^3.0.0",
        "lucide-react": "^1.27.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^7.18.1",
        "recharts": "^2.15.4",
        "tailwind-merge": "^2.6.1",
        "tailwindcss-animate": "^1.0.7"
